<mujoco model="real_factory_floor">
  <compiler coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.005"/>

  <asset>
    <!-- Textures and Materials -->
    <texture name="floor_grid" type="2d" builtin="checker" rgb1=".12 .14 .18" rgb2=".18 .20 .26" width="512" height="512"/>
    <material name="floor_mat" texture="floor_grid" texrepeat="2 2" texuniform="true"/>
    
    <material name="wall_mat" rgba="0.2 0.25 0.3 1.0"/>
    <material name="metal_dark" rgba="0.15 0.18 0.22 1.0" shininess="0.8"/>
    <material name="metal_bright" rgba="0.7 0.75 0.8 1.0" shininess="0.9"/>
    <material name="table_wood" rgba="0.45 0.28 0.15 1.0"/>
    <material name="press_orange" rgba="0.95 0.4 0.1 1.0" shininess="0.5"/>
    <material name="cabinet_red" rgba="0.85 0.15 0.15 1.0" shininess="0.4"/>
    <material name="conveyor_yellow" rgba="0.9 0.7 0.1 1.0"/>
    <material name="amr_body_mat" rgba="0.05 0.55 0.95 1.0" shininess="0.9"/>
    <material name="wheel_mat" rgba="0.05 0.05 0.05 1.0"/>
    <material name="sensor_mat" rgba="0.1 0.9 0.3 1.0" emission="0.6"/>
    <material name="warning_mat" rgba="1.0 0.2 0.2 0.4"/>
  </asset>

  <worldbody>
    <!-- Overhead Factory Lighting -->
    <light name="light1" pos="4 4 10" dir="0 0 -1" directional="true" diffuse=".8 .8 .8" specular=".3 .3 .3"/>
    <light name="light2" pos="11 11 10" dir="0 0 -1" directional="true" diffuse=".7 .7 .7" specular=".2 .2 .2"/>

    <!-- 15m x 15m Factory Floor Plane -->
    <geom name="floor" type="plane" size="7.5 7.5 0.1" pos="7.5 7.5 0" material="floor_mat"/>

    <!-- Factory Outer Boundary Walls -->
    <geom name="wall_south" type="box" size="7.5 0.1 1.5" pos="7.5 0 1.5" material="wall_mat"/>
    <geom name="wall_north" type="box" size="7.5 0.1 1.5" pos="7.5 15 1.5" material="wall_mat"/>
    <geom name="wall_west" type="box" size="0.1 7.5 1.5" pos="0 7.5 1.5" material="wall_mat"/>
    <geom name="wall_east" type="box" size="0.1 7.5 1.5" pos="15 7.5 1.5" material="wall_mat"/>

    <!-- ========================================================================= -->
    <!-- DETAILED AMR-01 ROBOT BODY                                                -->
    <!-- ========================================================================= -->
    <body name="amr" pos="2.0 2.0 0.3">
      <joint name="robot_x" type="slide" axis="1 0 0" damping="5.0"/>
      <joint name="robot_y" type="slide" axis="0 1 0" damping="5.0"/>
      <joint name="robot_z" type="slide" axis="0 0 1" damping="5.0"/>
      
      <!-- Main Chassis Base (Blue Cylinder Body) -->
      <geom name="amr_base" type="cylinder" size="0.45 0.15" pos="0 0 0" material="amr_body_mat" mass="15"/>
      <!-- Top Cover Plate -->
      <geom name="amr_top" type="cylinder" size="0.42 0.02" pos="0 0 0.16" material="metal_bright"/>
      <!-- Left/Right Drive Wheels -->
      <geom name="wheel_left" type="cylinder" size="0.1 0.04" pos="0 0.4 -0.08" euler="90 0 0" material="wheel_mat"/>
      <geom name="wheel_right" type="cylinder" size="0.1 0.04" pos="0 -0.4 -0.08" euler="90 0 0" material="wheel_mat"/>
      <!-- LiDAR Dome & Safety Beacon -->
      <geom name="lidar_tower" type="cylinder" size="0.08 0.08" pos="0.2 0 0.22" material="metal_dark"/>
      <geom name="safety_beacon" type="sphere" size="0.06" pos="-0.2 0 0.22" material="sensor_mat"/>
    </body>

    <!-- ========================================================================= -->
    <!-- MACHINE STRUCTURE 1: Industrial Hydraulic Press Cell A (at 5, 5)          -->
    <!-- ========================================================================= -->
    <body name="pressA" pos="5.0 5.0 0.0">
      <!-- Warning Zone Outer Base Circle -->
      <geom name="press_warning" type="cylinder" size="2.0 0.01" pos="0 0 0.01" material="warning_mat"/>
      <!-- Heavy Duty Workbench Base -->
      <geom name="press_table" type="box" size="1.2 1.2 0.4" pos="0 0 0.4" material="metal_dark"/>
      <!-- Hydraulic Pillars (4 Legs) -->
      <geom name="pillar1" type="cylinder" size="0.08 0.8" pos="1.0 1.0 1.2" material="metal_bright"/>
      <geom name="pillar2" type="cylinder" size="0.08 0.8" pos="-1.0 1.0 1.2" material="metal_bright"/>
      <geom name="pillar3" type="cylinder" size="0.08 0.8" pos="1.0 -1.0 1.2" material="metal_bright"/>
      <geom name="pillar4" type="cylinder" size="0.08 0.8" pos="-1.0 -1.0 1.2" material="metal_bright"/>
      <!-- Top Heavy Press Head Block -->
      <geom name="press_head" type="box" size="1.3 1.3 0.35" pos="0 0 2.2" material="press_orange"/>
      <!-- Robotic Arm Mount Base -->
      <geom name="arm_base" type="cylinder" size="0.2 0.3" pos="0 0 0.95" material="metal_bright"/>
    </body>

    <!-- ========================================================================= -->
    <!-- MACHINE STRUCTURE 2: High Voltage Control Cabinet (at 10, 3)             -->
    <!-- ========================================================================= -->
    <body name="cabinet" pos="10.0 3.0 0.0">
      <!-- Warning Zone Base -->
      <geom name="cabinet_warning" type="cylinder" size="1.5 0.01" pos="0 0 0.01" material="warning_mat"/>
      <!-- Main Electrical Switchgear Cabinet Structure -->
      <geom name="cab_body" type="box" size="0.8 1.1 1.0" pos="0 0 1.0" material="cabinet_red"/>
      <!-- Front Control Panels & Screens -->
      <geom name="cab_screen" type="box" size="0.02 0.4 0.3" pos="-0.81 0 1.3" material="metal_dark"/>
      <geom name="cab_hmi" type="sphere" size="0.08" pos="-0.81 0.4 1.5" material="sensor_mat"/>
      <!-- Top Cable Duct Column -->
      <geom name="cab_duct" type="box" size="0.3 0.3 0.5" pos="0 0 2.2" material="metal_dark"/>
    </body>

    <!-- ========================================================================= -->
    <!-- MACHINE STRUCTURE 3: Automated Gantry Conveyor System (at 7, 11)           -->
    <!-- ========================================================================= -->
    <body name="conveyor" pos="7.0 11.0 0.0">
      <!-- Warning Zone Base -->
      <geom name="conveyor_warning" type="cylinder" size="2.2 0.01" pos="0 0 0.01" material="warning_mat"/>
      <!-- Long Roller Table Deck -->
      <geom name="conv_table" type="box" size="1.8 0.6 0.3" pos="0 0 0.6" material="conveyor_yellow"/>
      <!-- Support Workbench Legs -->
      <geom name="leg1" type="box" size="0.1 0.1 0.3" pos="1.5 0.5 0.3" material="metal_dark"/>
      <geom name="leg2" type="box" size="0.1 0.1 0.3" pos="-1.5 0.5 0.3" material="metal_dark"/>
      <geom name="leg3" type="box" size="0.1 0.1 0.3" pos="1.5 -0.5 0.3" material="metal_dark"/>
      <geom name="leg4" type="box" size="0.1 0.1 0.3" pos="-1.5 -0.5 0.3" material="metal_dark"/>
      <!-- Overhead Gantry Arch Structural Frame -->
      <geom name="gantry_post1" type="cylinder" size="0.08 1.0" pos="1.5 0 1.3" material="metal_dark"/>
      <geom name="gantry_post2" type="cylinder" size="0.08 1.0" pos="-1.5 0 1.3" material="metal_dark"/>
      <geom name="gantry_beam" type="box" size="1.6 0.1 0.1" pos="0 0 2.3" material="metal_bright"/>
    </body>
  </worldbody>
</mujoco>
