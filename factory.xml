<mujoco model="factory_floor">
  <compiler coordinate="local"/>
  <option gravity="0 0 -9.81"/>

  <asset>
    <!-- Grid Floor Material -->
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".2 .2 .2" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="7.5 7.5 10" dir="0 0 -1" directional="true"/>

    <!-- 15m x 15m Floor Plane centered at (7.5, 7.5) -->
    <geom name="floor" type="plane" size="7.5 7.5 0.1" pos="7.5 7.5 0" material="grid_mat"/>

    <!-- Cylindrical Autonomous Mobile Robot (AMR) with slide joints for 3D navigation -->
    <body name="robot" pos="2.0 2.0 0.5">
      <joint name="robot_x" type="slide" axis="1 0 0" damping="10.0"/>
      <joint name="robot_y" type="slide" axis="0 1 0" damping="10.0"/>
      <joint name="robot_z" type="slide" axis="0 0 1" damping="10.0"/>
      <geom name="amr" type="cylinder" size="0.4 0.5" rgba="0.1 0.6 1.0 1.0"/>
    </body>

    <!-- Obstacle 1: 3D Industrial Robotic Press at (5, 5, 2) with radius 2.0 -->
    <body name="press_obstacle" pos="5.0 5.0 2.0">
      <geom name="press" type="cylinder" size="2.0 2.0" rgba="0.95 0.35 0.1 0.65"/>
    </body>

    <!-- Obstacle 2: High Voltage Cabinet at (10, 3, 1.5) with radius 1.5 -->
    <body name="cabinet_obstacle" pos="10.0 3.0 1.5">
      <geom name="cabinet" type="cylinder" size="1.5 1.5" rgba="0.9 0.1 0.1 0.65"/>
    </body>

    <!-- Obstacle 3: Automated Gantry/Conveyor at (7, 11, 2.5) with radius 2.2 -->
    <body name="conveyor_obstacle" pos="7.0 11.0 2.5">
      <geom name="conveyor" type="cylinder" size="2.2 2.5" rgba="0.6 0.2 0.9 0.65"/>
    </body>
  </worldbody>
</mujoco>
